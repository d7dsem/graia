{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build graia_capture",
            "type": "shell",
            "windows": {
                "command": "${workspaceFolder}/scripts/deploy.bat",
                "args": ["-t", "graia_capture", "-m", "Debug"]
            },
            "linux": {
                "command": "${workspaceFolder}/scripts/deploy.sh",
                "args": ["-t", "graia_capture", "-m", "Debug"]
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
    ]
}